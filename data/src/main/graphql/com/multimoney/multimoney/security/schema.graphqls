type SecurityQuery {
  dataInformationClient(dataInformationClientInput: DataInformationClient): dataInformationClient

  validateSecurity(validateSecurityInput: validateSecurityInput): validateSecurity
}

type dataInformationClient {
  """
  dataInformationClient nombre
  """
  nombre: String!

  """
  dataInformationClient tipoIdentificacion
  """
  tipoIdentificacion: String!

  """
  dataInformationClient Status
  """
  status: Boolean!

  """
  dataInformationClient Message
  """
  message: String!

  """
  dataInformationClient regime
  """
  regimen: dataInformationClientRegime

  """
  dataInformationClient situation
  """
  situacion: dataInformationClientSituation

  """
  dataInformationClient activitiesList
  """
  actividades: [dataInformationClientActivity]
}

type dataInformationClientRegime {
  """
  dataInformationClientRegime codigo
  """
  codigo: Int!

  """
  dataInformationClientRegime descripcion
  """
  descripcion: String!
}

type dataInformationClientSituation {
  """
  dataInformationClientSituation moroso
  """
  moroso: String!

  """
  dataInformationClientSituation omiso
  """
  omiso: String!

  """
  dataInformationClientSituation estado
  """
