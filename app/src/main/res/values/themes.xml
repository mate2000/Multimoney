<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_screen</item>
        <item name="postSplashScreenTheme">@style/Theme.Multimoney</item>
    </style>

    <style name="Theme.Multimoney" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="OnfidoActivityTheme" parent="OnfidoBaseActivityTheme">
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <style name="ReactActivityTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
    </style>

    <style name="OnfidoToolbarTitleTextAppearance" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <style name="OnfidoShadowedScrollStyle">
        <item name="android:scrollbars">vertical</item>
    </style>

    <style name="OnVisaAddCardDialogButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.13</item>
        <item name="android:textColor">@color/visaAddCardAlertDialogButtonColor</item>
    </style>

    <style name="OnVisaAddCardDialogLabelStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">start</item>
        <item name="android:textColor">@color/visaAddCardAlertDialogTitleColor</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <style name="CustomDarkDatePickerStyle" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/green_500</item>
        <!--selected Item color-->
        <item name="colorControlActivated">@color/green</item>
        <!-- arrow borderColor-->
        <item name="android:selectableItemBackgroundBorderless">@android:color/transparent</item>
        <!-- Highlight item color-->
        <item name="colorControlHighlight">@color/green_500</item>
        <!--Calender Background color -->
        <item name="android:windowBackground">@drawable/bg_calendar_round_corners</item>
        <!-- Ok Cancel Color-->
        <item name="android:textColor">@color/green</item>
        <!-- Week TextColor-->
        <item name="android:textColorSecondary">@color/white</item>
        <!-- Calender Number color arrow color-->
        <item name="android:textColorPrimary">@color/white</item>
        <!--day , month-->
        <item name="android:textColorPrimaryInverse">@color/white</item>
        <!-- year-->
        <item name="android:textColorSecondaryInverse">@color/white</item>
    </style>
</resources>