<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@color/gray_800"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/onfido_upload_container_padding">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_circular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/green"
            app:indicatorSize="@dimen/onfido_circular_progress_indicator_size"
            app:trackColor="@color/gray_800"
            app:trackCornerRadius="@dimen/onfido_circular_progress_track_corner_radius"
            app:trackThickness="@dimen/onfido_circular_progress_thickness" />

        <TextView
            android:id="@+id/progressMessage"
            style="@style/OnfidoTextStyle.Body.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingTop="@dimen/onfido_upload_progress_dialog_top_padding"
            android:textColor="@color/white"
            android:textSize="@dimen/onfido_upload_message_text_size"
            android:visibility="visible"
            tools:text="Uploading" />
    </LinearLayout>

</FrameLayout>