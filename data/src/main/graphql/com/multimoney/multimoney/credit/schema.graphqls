  idBrand: Int!

  tenantId: String

  traceIdentifier: String

  idUserRequest: String
}

type regularExpression {
  """
  regularExpression INT_PK_VEN_CAT_EXPRESION_REGULAR
  """
  iNT_PK_VEN_CAT_EXPRESION_REGULAR: Int!

  """
  regularExpression STR_LLAVE_04
  """
  sTR_LLAVE_04: String!

  """
  regularExpression STR_DESCRIPCION
  """
  sTR_DESCRIPCION: String!

  """
  regularExpression STR_PATRON_EXPRESION
  """
  sTR_PATRON_EXPRESION: String!

  """
