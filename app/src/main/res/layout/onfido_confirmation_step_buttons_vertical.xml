<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/verticalContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.onfido.android.sdk.capture.ui.widget.Button
        android:id="@+id/button_primary"
        style="@style/OnfidoFlatButton.NoMargin" />

    <com.onfido.android.sdk.capture.ui.widget.Button
        android:id="@+id/button_secondary"
        style="@style/OnfidoFlatButton.NoMargin"
        android:layout_marginTop="@dimen/onfido_spacing_1x"
        app:onfidoButtonType="secondary"
        app:onfidoButtonText="@string/onfido_doc_confirmation_button_secondary_passport" />
</LinearLayout>
