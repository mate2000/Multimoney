  """
  tASA_INTERES_NORMAL: String!

  """
  products STR_TASA_INTERES_NORMAL
  """
  sTR_TASA_INTERES_NORMAL: String!

  """
  products CUOTA
  """
  cUOTA: String!

  """
  products CUOTA_AUTORIZA
  """
  cUOTA_AUTORIZA: String!

  """
  products COMISION_DESEMBOLSO
  """
  cOMISION_DESEMBOLSO: String!

  """
  products STR_COMISION_DESEMBOLSO
  """
  sTR_COMISION_DESEMBOLSO: String!

  """
  products FECHA_PAGO
  """
  fECHA_PAGO: String!

  """
  products NOMBRE_MONEDA
