  """
  dataInformationClientActivity tipo
  """
  tipo: String!

  """
  dataInformationClientActivity codigo
  """
  codigo: String!

  """
  dataInformationClientActivity descripcion
  """
  descripcion: String!
}

input DataInformationClient {
  identification: String!

  idBrand: Int!

  user: String!

  tenantId: String

  traceIdentifier: String
}

type validateSecurity {
  """
  validateSecurity Status
  """
  status: Int

  """
  validateSecurity Message
  """
  message: String
}

input validateSecurityInput {
  pkUser: Int!

  password: String!

  user: String!

  idBrand: Int!

  tenantId: String

  traceIdentifier: String
}

type SecurityMutation {
  userValidation(userValidationInput: userValidationInput): userValidation

  updateUserRegister(updateUserRegisterInput: UpdateUserRegister): updateUserRegister
}

