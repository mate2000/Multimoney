type CreditQuery {
  creditOffer(creditOfferInput: creditOfferInput): creditOffer

  paymentAmount(paymentAmountInput: balanceCreditInput): paymentAmount

  screenConfigText(screenConfigInput: screenConfigInput): [screenConfigText]

  employmentSituation(employmentSituationInput: screenConfigInput): [screenConfigText]

  ocupation(ocupationInput: screenConfigInput): [screenConfigText]

  homeProvince(homeProvinceInput: screenConfigInput): [screenConfigText]

  homeCanton(homeCantonInput: screenConfigInput): [screenConfigText]

  homeDistrict(homeDistrictInput: screenConfigInput): [screenConfigText]

  companyProvince(companyProvinceInput: screenConfigInput): [screenConfigText]

  companyCanton(companyCantonInput: screenConfigInput): [screenConfigText]

  companyDistrict(companyDistrictInput: screenConfigInput): [screenConfigText]

  regularExpression(regularExpressionInput: regularExpressionInput): [regularExpression]

  banks(banksInput: screenConfigInput): [screenConfigText]
}

type creditOffer {
  """
  creditOffer products
  """
  products: [products]
}

