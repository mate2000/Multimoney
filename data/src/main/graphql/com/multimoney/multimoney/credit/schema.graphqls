  """
  iNT_FK_LLAVE_FORANEA: Int!

  """
  regularExpression INT_ID_TIPO_CUENTA_DESEMBOLSO
  """
  iNT_ID_TIPO_CUENTA_DESEMBOLSO: Int!
}

input regularExpressionInput {
  user: String!

  idBrand: Int!

  tenantId: String

  traceIdentifier: String
}

type CreditMutation {
  saveCreditFlowStep(saveCreditFlowStepInput: saveCreditFlowStepInput): saveCreditFlowStep
}

type saveCreditFlowStep {
  """
  saveCreditFlowStep MessageInfo
  """
  messageInfo: String!

  """
  saveCreditFlowStep Status
  """
  status: Int!

  """
  saveCreditFlowStep Result
  """
  result: String!
}

input saveCreditFlowStepInput {
  user: String!

  idBrand: Int!

  tenantId: String

  traceidentifier: String

  """
  saveCreditFlowStepInput infoQuestion
  """
  infoQuestion: [questionsDataList]
}

input questionsDataList {
  idQuestionRequestCredit: Int

  idOptionQuestionRequestCredit: Int

  idLogUserRequest: Int

  idUser: Int

  createUser: String

  updateUser: String

  createDate: Date

  updateDate: Date

  identificator: String

  value: String

  active: Boolean

  controlType: String

  isCoreCatalogue: Boolean

  isBranchOfficeCatalogue: Boolean

  useValue: Boolean

  maximumAmount: String

  description: String

  valueCatalogue: String

  idIdentificatorCatalogue: String
}

"""
The `Date` scalar type represents a year, month and day in accordance with the [ISO-8601](https://en.wikipedia.org/wiki/ISO_8601) standard.
"""
scalar Date

schema {
  query: CreditQuery
  mutation: CreditMutation
}
