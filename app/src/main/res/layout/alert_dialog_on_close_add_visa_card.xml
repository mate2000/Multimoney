<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/visaAddCardAlertDialogBackgroundColor"
    android:minHeight="123dp"
    android:paddingStart="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/visaAddCardAlertDialogBackgroundColor"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/title"
            style="@style/OnVisaAddCardDialogLabelStyle"
            android:letterSpacing="0.06"
            android:paddingTop="24dp"
            android:text="@string/visa_add_card_dialog_title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/description"
            style="@style/OnVisaAddCardDialogLabelStyle"
            android:letterSpacing="0.04"
            android:paddingTop="15dp"
            android:paddingEnd="4dp"
            android:text="@string/visa_add_card_dialog_description"
            android:textColor="@color/visaAddCardAlertDialogDescriptionColor"
            android:textSize="14sp"
            android:textStyle="normal" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/content">

        <Button
            android:id="@+id/continueBtn"
            style="@style/OnVisaAddCardDialogButtonStyle"
            android:text="@string/button_continue" />

        <Button
            android:id="@+id/cancelBtn"
            style="@style/OnVisaAddCardDialogButtonStyle"
            android:paddingStart="32dp"
            android:text="@string/cancel" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>