scalar Decimal

input creditOfferInput {
  pkUser: Int!

  idBrand: Int!

  tenantId: String

  traceIdentifier: String
}

type paymentAmount {
  """
  paymentAmount paymentAmount
  """
  paymentAmount: Decimal!

  """
  paymentAmount paymentAmountLabel
  """
  paymentAmountLabel: String!
}

input balanceCreditInput {
  amount: Decimal!

  months: String!

  idProduct: String!

  currencySymbol: String!

  user: String!

  idBrand: Int!

  tenantId: String

  traceIdentifier: String
}

